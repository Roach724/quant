# AI Decision Engine — Environment Variables
# Copy to .env and fill in your keys.
# The .env file is git-ignored; never commit real keys.

# DeepSeek API (required for LLM analysis + execution decisions)
# Get from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# LLMQuant MCP (optional — provides SEC filings, 13F, institutional data)
# Get from: https://llmquantdata.com/dashboard → API Keys
LLMQUANT_API_KEY=
